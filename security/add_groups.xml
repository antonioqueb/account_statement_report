<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_add" model="ir.module.category"><field name="name">ADD privado</field><field name="sequence">35</field></record>
    <record id="privilege_add" model="res.groups.privilege"><field name="name">Visor ADD</field><field name="category_id" ref="category_add"/></record>
    <record id="group_add_reader" model="res.groups"><field name="name">Consulta ADD</field><field name="privilege_id" ref="privilege_add"/></record>
    <record id="group_add_operator" model="res.groups"><field name="name">Operador ADD</field><field name="privilege_id" ref="privilege_add"/><field name="implied_ids" eval="[(4, ref('group_add_reader'))]"/></record>
    <record id="group_add_admin" model="res.groups"><field name="name">Administrador ADD</field><field name="privilege_id" ref="privilege_add"/><field name="implied_ids" eval="[(4, ref('group_add_operator'))]"/></record>
    <record id="group_add_export" model="res.groups"><field name="name">ADD: exportar y descargar</field></record>
    <record id="group_add_access" model="res.groups"><field name="name">ADD: gestión de accesos (requiere administrar usuarios)</field></record>
    <!-- Deliberately no users, no implied base.group_user and no default grants. -->
