<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna Pedimento en las líneas de la factura -->
    <record id="view_move_form_som_pedimento" model="ir.ui.view">
        <field name="name">account.move.form.som.pedimento</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="after">
                <field name="x_pedimento" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
