<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_add_users_grants" model="ir.ui.view">
        <field name="name">res.users.add.grants</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Autorización explícita ADD" groups="account_statement_report.group_add_access">
                    <field name="add_company_ids" widget="many2many_tags" domain="[('id', 'in', company_ids)]" options="{'no_create': True}"/>
                    <div class="text-muted">Requiere también permiso efectivo para administrar usuarios. Los roles ADD no se asignan automáticamente.</div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="action_add_dashboard" model="ir.actions.client">
        <field name="name">Tablero ADD</field>
        <field name="tag">som_add.explorer</field>
        <field name="params" eval="{'mode': 'dashboard'}"/>
    </record>
    <record id="action_add_issued" model="ir.actions.client">
        <field name="name">Emitidos</field>
        <field name="tag">som_add.explorer</field>
        <field name="params" eval="{'mode': 'issued'}"/>
    </record>
    <record id="action_add_received" model="ir.actions.client">
        <field name="name">Recibidos</field>
        <field name="tag">som_add.explorer</field>
        <field name="params" eval="{'mode': 'received'}"/>
    </record>
    <record id="view_add_document_list" model="ir.ui.view">
        <field name="name">som.add.document.list</field>
        <field name="model">som.add.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="fiscal_date desc,id desc">
                <field name="company_id"/>
                <field name="fiscal_date"/>
                <field name="emitter_name"/>
                <field name="receiver_name" optional="hide"/>
                <field name="series"/>
                <field name="folio"/>
                <field name="kind"/>
                <field name="currency"/>
                <field name="subtotal"/>
                <field name="discount"/>
                <field name="vat"/>
                <field name="withheld"/>
                <field name="total"/>
                <field name="method"/>
                <field name="complements" optional="show"/>
                <field name="sat_state"/>
                <field name="consistency"/>
                <field name="uuid" optional="hide"/>
                <field name="classification" optional="hide"/>
                <field name="net_base" optional="hide"/>
                <field name="base_mxn" optional="hide"/>
                <field name="total_mxn" optional="hide"/>
                <field name="conversion_source" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_add_document_search" model="ir.ui.view">
        <field name="name">som.add.document.search</field>
        <field name="model">som.add.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid"/>
                <field name="emitter_rfc"/>
                <field name="receiver_rfc"/>
                <field name="emitter_name"/>
                <field name="receiver_name"/>
                <field name="company_id"/>
                <field name="currency"/>
                <field name="kind"/>
                <field name="classification"/>
                <field name="batch_id"/>
                <filter name="issued" string="Emitidos" domain="[('issued','=',True)]"/>
                <filter name="received" string="Recibidos" domain="[('received','=',True)]"/>
                <filter name="date" string="Fecha fiscal" date="fiscal_date"/>
                <filter name="unqueried" string="SAT no consultado" domain="[('sat_state','=','unknown')]"/>
                <filter name="archived" string="Archivados" domain="[('active','=',False)]"/>
                <group>
                    <filter name="group_company" string="Compañía" context="{'group_by':'company_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by':'fiscal_date:month'}"/>
                    <filter name="group_currency" string="Moneda" context="{'group_by':'currency'}"/>
                    <filter name="group_vendor" string="Emisor" context="{'group_by':'emitter_rfc'}"/>
                    <filter name="group_customer" string="Receptor" context="{'group_by':'receiver_rfc'}"/>
                    <filter name="group_batch" string="Lote" context="{'group_by':'batch_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by':'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_add_document_form" model="ir.ui.view">
        <field name="name">som.add.document.form</field>
        <field name="model">som.add.document</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <button name="reprocess" type="object" string="Reprocesar" groups="account_statement_report.group_add_operator"/>
                </header>
                <sheet>
                    <h1>
                        <field name="uuid"/>
                    </h1>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="fiscal_datetime"/>
                            <field name="kind"/>
                            <field name="issued"/>
                            <field name="received"/>
                            <field name="emitter_rfc"/>
                            <field name="emitter_name"/>
                            <field name="receiver_rfc"/>
                            <field name="receiver_name"/>
                        </group>
                        <group>
                            <field name="currency"/>
                            <field name="subtotal"/>
                            <field name="discount"/>
                            <field name="vat"/>
                            <field name="withheld"/>
                            <field name="total"/>
                            <field name="sat_state"/>
                            <field name="consistency"/>
                        </group>
                    </group>
                    <field name="alerts"/>
                    <notebook>
                        <page string="Conceptos">
                            <field name="concept_ids"/>
                        </page>
                        <page string="Impuestos">
                            <field name="tax_ids"/>
                        </page>
                        <page string="Pagos">
                            <field name="payment_ids"/>
                        </page>
                        <page string="Relaciones">
                            <field name="relation_ids"/>
                        </page>
                        <page string="Trazabilidad">
                            <group>
                                <field name="batch_id"/>
                                <field name="sha256"/>
                                <field name="parser_version"/>
                                <field name="filename"/>
                                <field name="notes"/>
                                <field name="reference"/>
                                <field name="classification"/>
                                <field name="archive_reason"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_add_batch_list" model="ir.ui.view">
        <field name="name">som.add.batch.list</field>
        <field name="model">som.add.batch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="company_id"/>
                <field name="direction"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="total_count"/>
                <field name="imported_count"/>
                <field name="duplicate_count"/>
                <field name="rejected_count"/>
                <field name="failed_count"/>
                <field name="pending_count"/>
                <field name="progress" widget="progressbar"/>
            </list>
        </field>
    </record>
    <record id="view_add_batch_form" model="ir.ui.view">
        <field name="name">som.add.batch.form</field>
        <field name="model">som.add.batch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="seal" type="object" string="Cerrar recepción e iniciar" invisible="state != 'pending'" groups="account_statement_report.group_add_operator"/>
                    <button name="process_block" type="object" string="Procesar siguiente bloque" invisible="state != 'processing'" groups="account_statement_report.group_add_operator"/>
                    <button name="retry" type="object" string="Reintentar pendientes/fallidos" invisible="state not in ['issues','failed','cancelled']" groups="account_statement_report.group_add_operator"/>
                    <button name="cancel" type="object" string="Cancelar pendientes" invisible="state not in ['pending','processing','failed']" groups="account_statement_report.group_add_operator"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="direction"/>
                            <field name="user_id"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                        <group>
                            <field name="total_count"/>
                            <field name="imported_count"/>
                            <field name="duplicate_count"/>
                            <field name="rejected_count"/>
                            <field name="failed_count"/>
                            <field name="pending_count"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="item_ids"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_add_config_form" model="ir.ui.view">
        <field name="name">som.add.config.form</field>
        <field name="model">som.add.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="xml_mb"/>
                        <field name="upload_mb"/>
                        <field name="batch_mb"/>
                        <field name="entries"/>
                        <field name="block_size"/>
                        <field name="retention_days"/>
                    </group>
                    <p>Los originales incorporados se conservan. Los archivos pendientes o fallidos vencidos se eliminan. Las exportaciones se entregan en la misma solicitud y no generan archivos públicos.</p>
                </sheet>
            </form>
        </field>
    </record>
    <menuitem id="menu_add_root" name="ADD" sequence="25" web_icon="account_statement_report,static/description/add_icon.svg" groups="account_statement_report.group_add_reader"/>
    <menuitem id="menu_add_dashboard" name="Tablero" parent="menu_add_root" action="action_add_dashboard" sequence="10"/>
    <menuitem id="menu_add_issued" name="Emitidos" parent="menu_add_root" action="action_add_issued" sequence="20"/>
    <menuitem id="menu_add_received" name="Recibidos" parent="menu_add_root" action="action_add_received" sequence="30"/>
